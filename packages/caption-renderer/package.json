{
  "name": "@perpix/caption-renderer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "description": "How a caption looks at a moment in time. Shared by the app, which exports the video, and the admin panel, which previews the presets, so the two can never differ.",
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react.tsx",
    "./offscreen": "./src/offscreen.ts"
  },
  "scripts": {
    "typecheck": "tsrs -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "@types/react": "^19",
    "vitest": "catalog:",
    "@perpix/tooling": "workspace:*",
    "oxlint": "catalog:",
    "oxfmt": "catalog:",
    "tsrs": "catalog:"
  },
  "dependencies": {
    "konva": "^10.9.1"
  },
  "peerDependencies": {
    "react": "^19"
  }
}
