# Copy to deploy/test.env on the server and replace example.invalid values.
# VITE values are public browser configuration, embedded at BUILD time.
# Use the actual API base path expected by the backend, including /api if needed.
VITE_PERPIX_API_URL=https://api.example.invalid
VITE_PERPIX_APP_URL=https://test.example.invalid
VITE_OBJECT_STORAGE_PUBLIC_ENDPOINT=https://storage.example.invalid
VITE_PERPIX_MAIN_URL=https://perpixai.ir
VITE_APP_FONT_BASE_URL=/fonts
VITE_APP_TELEGRAM_SUPPORT=
VITE_APP_SENTRY_DSN=
# Match the backend's current tax configuration. Do not guess a value.
VITE_APP_PERPIX_TAX_PERCENT=
PNPM_VERSION=11.4.0
PACKAGE_REGISTRY=https://registry.npmmirror.com
