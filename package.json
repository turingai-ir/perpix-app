{
  "name": "perpix-web",
  "private": true,
  "packageManager": "pnpm@11.4.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:app": "turbo run dev --filter=perpix-app",
    "dev:admin": "turbo run dev --filter=perpix-admin-panel",
    "build": "turbo run build",
    "lint": "oxlint .",
    "typecheck": "turbo run typecheck",
    "storybook": "pnpm --filter perpix-storybook dev",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test:tooling": "pnpm --filter @perpix/tooling test"
  },
  "devDependencies": {
    "turbo": "^2.11.13",
    "@perpix/tooling": "workspace:*",
    "oxlint": "catalog:",
    "oxfmt": "catalog:",
    "tsrs": "catalog:"
  }
}
